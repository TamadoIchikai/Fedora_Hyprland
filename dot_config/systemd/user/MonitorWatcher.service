[Unit]
Description=Compositor Monitor Hotplug Watchdog
# Runs for any graphical session (Hyprland or MangoWC), which is the common
# parent of both hyprland-session.target and mango-session.target.
BindsTo=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/MonitorWatcher.sh
# If the script crashes, systemd will automatically restart it after 3 seconds
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
