	<action>
		<icon>peazip</icon>
		<name>Add to TAR</name>
		<submenu>PeaZip → Add to archive</submenu>
		<unique-id>1791836280000000-11</unique-id>
		<command>env peazip -add2tar %F</command>
		<description>Create a TAR archive</description>
		<range>*</range>
		<patterns>*</patterns>
		<directories />
		<audio-files />
		<image-files />
		<other-files />
		<text-files />
		<video-files />
	</action>
	<action>
		<icon>peazip</icon>
		<name>Test archive</name>
		<submenu>PeaZip → Extract</submenu>
		<unique-id>1791836280000000-12</unique-id>
		<command>env peazip -ext2test %F</command>
		<description>Test archive integrity</description>
		<range>*</range>
		<patterns
        >*.7z;*.7Z;*.zip;*.ZIP;*.rar;*.RAR;*.tar;*.TAR;*.gz;*.GZ;*.bz2;*.BZ2;*.xz;*.XZ;*.zst;*.ZST;*.iso;*.ISO</patterns>
		<other-files />
	</action>
	<action>
		<icon>peazip</icon>
		<name>Extract...</name>
		<submenu>PeaZip → Extract</submenu>
		<unique-id>1791836280000000-13</unique-id>
		<command>env peazip -ext2main %F</command>
		<description>Open PeaZip extraction interface</description>
		<range>*</range>
		<patterns
        >*.7z;*.7Z;*.zip;*.ZIP;*.rar;*.RAR;*.tar;*.TAR;*.gz;*.GZ;*.bz2;*.BZ2;*.xz;*.XZ;*.zst;*.ZST;*.iso;*.ISO</patterns>
		<other-files />
	</action>
	<action>
		<icon>peazip</icon>
		<name>Extract here</name>
		<submenu>PeaZip → Extract</submenu>
		<unique-id>1791836280000000-14</unique-id>
		<command>env peazip -ext2here %F</command>
		<description>Extract archive(s) into the current directory</description>
		<range>*</range>
		<patterns
        >*.7z;*.7Z;*.zip;*.ZIP;*.rar;*.RAR;*.tar;*.TAR;*.gz;*.GZ;*.bz2;*.BZ2;*.xz;*.XZ;*.zst;*.ZST;*.iso;*.ISO</patterns>
		<other-files />
	</action>
	<action>
		<icon>peazip</icon>
		<name>Extract here (smart)</name>
		<submenu>PeaZip → Extract</submenu>
		<unique-id>1791836280000000-15</unique-id>
		<command>env peazip -ext2folder %F</command>
		<description>Extract here using PeaZip folder policy</description>
		<range>*</range>
		<patterns
        >*.7z;*.7Z;*.zip;*.ZIP;*.rar;*.RAR;*.tar;*.TAR;*.gz;*.GZ;*.bz2;*.BZ2;*.xz;*.XZ;*.zst;*.ZST;*.iso;*.ISO</patterns>
		<other-files />
	</action>
	<action>
		<icon>peazip</icon>
		<name>Extract here (new folder)</name>
		<submenu>PeaZip → Extract</submenu>
		<unique-id>1791836280000000-16</unique-id>
		<command>env peazip -ext2newfolder %F</command>
		<description>Always extract into a new folder</description>
		<range>*</range>
		<patterns
        >*.7z;*.7Z;*.zip;*.ZIP;*.rar;*.RAR;*.tar;*.TAR;*.gz;*.GZ;*.bz2;*.BZ2;*.xz;*.XZ;*.zst;*.ZST;*.iso;*.ISO</patterns>
		<other-files />
	</action>
	<action>
		<icon>application-x-iso9660-appimage</icon>
		<name>Create Desktop Entry (AppImage)</name>
		<submenu>AppImage</submenu>
		<unique-id>1791836280000000-1</unique-id>
		<command
        >bash -c '"$HOME/.local/bin/AppImageManager.sh" install --dir "$1"' -- %f</command>
		<description
        >Generate a desktop entry and icon for the selected AppImage</description>
		<range>*</range>
		<patterns>*.AppImage</patterns>
		<other-files />
	</action>
	<action>
		<icon>emblem-remove</icon>
		<name>Remove AppImage (from Desktop)</name>
		<submenu>AppImage</submenu>
		<unique-id>1791836280000000-2</unique-id>
		<command>bash -lc '"$HOME/.local/bin/AppImageManager.sh" delete'</command>
		<description>Remove the installed AppImage desktop entry and icon</description>
		<range>*</range>
		<patterns>*.AppImage</patterns>
		<other-files />
	</action>
	<action>
		<icon>system-run</icon>
		<name>Open Directory as Admin</name>
		<submenu>Tools</submenu>
		<unique-id>1791836280000000-5</unique-id>
		<command>bash -c '"$HOME/.local/bin/thunar-admin.sh" "$1"' -- %f</command>
		<description>Open the selected directory as administrator</description>
		<range>*</range>
		<patterns>*</patterns>
		<directories />
	</action>
	<action>
		<icon>document-scan</icon>
		<name>Scan with gdu</name>
		<submenu>Tools</submenu>
		<unique-id>1791836280000000-6</unique-id>
		<command>foot --working-directory=%f gdu</command>
		<description>Scan storage usage in the selected directory with gdu</description>
		<range>*</range>
		<patterns>*</patterns>
		<directories />
	</action>
</actions>
