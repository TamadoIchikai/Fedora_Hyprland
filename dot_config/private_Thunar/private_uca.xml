		<text-files />
		<video-files />
	</action>
	<action>
		<icon>peazip</icon>
		<name>Add to XZ</name>
		<submenu>PeaZip → Add to archive</submenu>
		<unique-id>1791836280000000-10</unique-id>
		<command>env peazip -add2xz %F</command>
		<description>Create an XZ archive</description>
		<range>*</range>
		<patterns>*</patterns>
		<directories />
		<audio-files />
