<?xml version="1.0" encoding="UTF-8"?>
<actions>
<!-- PeaZip submenu -->

<!-- ==================== EXTRACT ==================== -->

<action>
	<icon>peazip</icon>
	<name>Open archive</name>
	<submenu>PeaZip → Extract</submenu>
	<unique-id>peazip-1</unique-id>
	<command>peazip -ext2browse %F</command>
	<description>Open and browse archive in PeaZip</description>
	<range>*</range>
	<patterns>*.7z;*.zip;*.zipx;*.rar;*.tar;*.gz;*.bz2;*.xz;*.zst;*.pea;*.wim;*.iso</patterns>
	<other-files/>
</action>

<action>
	<icon>peazip</icon>
	<name>Extract...</name>
	<submenu>PeaZip → Extract</submenu>
	<unique-id>peazip-2</unique-id>
	<command>peazip -ext2main %F</command>
	<description>Open PeaZip extraction interface</description>
	<range>*</range>
	<patterns>*.7z;*.zip;*.zipx;*.rar;*.tar;*.gz;*.bz2;*.xz;*.zst;*.pea;*.wim;*.iso</patterns>
	<other-files/>
</action>

<action>
	<icon>peazip</icon>
	<name>Extract here</name>
	<submenu>PeaZip → Extract</submenu>
	<unique-id>peazip-3</unique-id>
	<command>peazip -ext2here %F</command>
	<description>Extract archive(s) here</description>
	<range>*</range>
	<patterns>*.7z;*.zip;*.zipx;*.rar;*.tar;*.gz;*.bz2;*.xz;*.zst;*.pea;*.wim;*.iso</patterns>
	<other-files/>
</action>

<action>
	<icon>peazip</icon>
	<name>Extract here (smart)</name>
	<submenu>PeaZip → Extract</submenu>
	<unique-id>peazip-4</unique-id>
	<command>peazip -ext2folder %F</command>
	<description>Extract here using PeaZip's folder policy</description>
	<range>*</range>
	<patterns>*.7z;*.zip;*.zipx;*.rar;*.tar;*.gz;*.bz2;*.xz;*.zst;*.pea;*.wim;*.iso</patterns>
	<other-files/>
</action>

<action>
	<icon>peazip</icon>
	<name>Extract here (new folder)</name>
	<submenu>PeaZip → Extract</submenu>
	<unique-id>peazip-5</unique-id>
	<command>peazip -ext2newfolder %F</command>
	<description>Always extract into a new folder</description>
	<range>*</range>
	<patterns>*.7z;*.zip;*.zipx;*.rar;*.tar;*.gz;*.bz2;*.xz;*.zst;*.pea;*.wim;*.iso</patterns>
	<other-files/>
</action>

<action>
	<icon>peazip</icon>
	<name>Test archive</name>
	<submenu>PeaZip → Extract</submenu>
	<unique-id>peazip-7</unique-id>
	<command>peazip -ext2test %F</command>
	<description>Test archive integrity</description>
	<range>*</range>
	<patterns>*.7z;*.zip;*.zipx;*.rar;*.tar;*.pea;*.wim</patterns>
	<other-files/>
</action>


<!-- ==================== ADD TO ARCHIVE ==================== -->

<!-- Single file/directory: configurable archive creation -->
<action>
	<icon>peazip</icon>
	<name>Add to archive...</name>
	<submenu>PeaZip → Add to archive</submenu>
	<unique-id>peazip-8</unique-id>
	<command>peazip -add2archive %F</command>
	<description>Open PeaZip archive creation interface</description>
	<range>1</range>
	<patterns>*</patterns>
	<other-files/>
	<directories/>
</action>


