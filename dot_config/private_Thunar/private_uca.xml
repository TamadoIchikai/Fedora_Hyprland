<?xml version="1.0" encoding="UTF-8" ?>
<actions>
    <action>
       	<icon>utilities-terminal</icon>
       	<name>Open Terminal here</name>
           <unique-id>1791836280000000-3</unique-id>
       	<command>foot --working-directory=%f</command>
       	<description>Open foot terminal in current directory</description>
       	<patterns>*</patterns>
       	<directories />
    	</action>
	<action>
		<icon>code-context</icon>
		<name>Open IDE here</name>
		<unique-id>1791836280000000-4</unique-id>
		<command>zed -n %f</command>
		<description>Open the selected directory in Zed</description>
		<range>*</range>
		<patterns>*</patterns>
		<directories />
	</action>
	<action>
		<icon>peazip</icon>
		<name>Add to Archive...</name>
		<submenu>PeaZip → Add to archive</submenu>
		<unique-id>1791836280000000-6</unique-id>
		<command>env peazip -add2archive %F</command>
		<description>Open PeaZip archive creation interface</description>
		<range>*</range>
		<patterns>*</patterns>
		<directories />
		<audio-files />
		<image-files />
		<other-files />
		<text-files />
		<video-files />
	</action>
	<action>
		<icon>peazip</icon>
		<name>Add to 7Z</name>
		<submenu>PeaZip → Add to archive</submenu>
		<unique-id>1791836280000000-7</unique-id>
		<command>env peazip -add27z %F</command>
		<description>Create a 7Z archive</description>
		<range>*</range>
		<patterns>*</patterns>
		<directories />
		<audio-files />
		<image-files />
		<other-files />
		<text-files />
		<video-files />
	</action>
