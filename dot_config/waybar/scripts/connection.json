{
"bluetooth": {
    "format": "\udb80\udcaf",
    "format-disabled": "\udb80\udcb2",
    "format-connected": "\udb80\udcb1",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "$HOME/.config/waybar/scripts/workspace-toggle.sh blueman-manager blueman-manager"
},
"network": {
    "interface": "wlo1",         
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format": "{essid} {frequency}MHz {signalStrength}%",
    "interval": 5,
    "on-click": "qs -c quickshell_modules ipc call wifi toggle",
    // Right click: toggle Cloudflare WARP (the script refreshes custom/warp via signal 8).
    "on-click-right": "$HOME/.config/waybar/scripts/warp-waybar.sh toggle",
    "format-icons": [
	    "󰤯",   
	    "󰤟",   
	    "󰤢",   
	    "󰤥",   
	    "󰤨"
	  ]
  },
"custom/localsend": {
    "format":"{icon}",
    "format-icons": "",
    "tooltip-format": "Left: send clipboard\nRight: pick files to send\nMiddle: show/hide LocalSend",
    // Left: clipboard (copied files / image / text) -> LocalSend's Send tab, then pick a device.
    "on-click": "$HOME/.local/bin/localsend-send.sh --clipboard",
    // Right: file picker first, then the same.
    "on-click-right": "$HOME/.local/bin/localsend-send.sh --pick",
    // Middle: show/park the window without adding anything.
    "on-click-middle": "$HOME/.config/waybar/scripts/workspace-toggle.sh org.localsend.localsend_app LocalSend.AppImage"
},

"custom/warp": {
    // Same clicks as the network module (bigger target): left = Wi-Fi menu,
    // right = toggle WARP. No polling: runs once at start, then on
    // `pkill -RTMIN+8 waybar` (sent by warp-waybar.sh after each toggle).
    "exec": "$HOME/.config/waybar/scripts/warp-waybar.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "qs -c quickshell_modules ipc call wifi toggle",
    "on-click-right": "$HOME/.config/waybar/scripts/warp-waybar.sh toggle"
},

"group/connection": {
    "orientation": "horizontal",
    "modules": ["custom/localsend","bluetooth","network","custom/warp"]
  }
}
