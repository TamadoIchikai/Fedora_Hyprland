# Export PATH
export PATH="$PATH:$HOME/.local/bin"
export PATH="$PATH:$HOME/bin"

# Input method
export XMODIFIERS=@im=fcitx
export INPUT_METHOD=fcitx
export SDL_IM_MODULE=fcitx
export GLFW_IM_MODULE=ibus

# Default apps
export EDITOR="nvim"
export TERMINAL=foot
export UV_PROJECT_ENVIRONMENT=".env_linux"
export RESTIC_SOURCE_BASE="/mnt/sda2"

# Qt theme
export QT_QPA_PLATFORMTHEME=qt6ct
export GTK_USE_PORTAL=1

# Gtk theme
export ADW_DEBUG_COLOR_SCHEME=prefer-dark

# -----------------------------
# SSH agent for KeePassXC
# -----------------------------

# The agent itself is started by ~/.local/bin/autostart.sh inside the
# graphical session, so it can show the KeePassXC "confirm" askpass dialog.
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/ssh-agent.sock"

# Detect current Wayland compositor
case "$XDG_CURRENT_DESKTOP" in
    Hyprland)
        export DESKTOP_COMPOSITOR="hyprland"
        export WM_CURR="hyprland"
        ;;
    MangoWC)
        export DESKTOP_COMPOSITOR="mangowc"
        export WM_CURR="mangowc"
        ;;
    *)
        export DESKTOP_COMPOSITOR="unknown"
        ;;
esac

# -----------------------------
# Auto-start Hyprland on tty1
# -----------------------------

if [[ -z "${DISPLAY:-}" ]] && [[ "$(tty)" == "/dev/tty1" ]] && { command -v Hyprland || command -v hyprland || command -v start-hyprland; } >/dev/null 2>&1; then
    exec start-hyprland
fi
